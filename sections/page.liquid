{% stylesheet %}
  .fwb-legal {
    background: var(--fwb-grey-100);
    padding-block: var(--fwb-section-pad);
    min-height: 50vh;
  }
  .fwb-legal__wrap { max-width: 760px; }
  .fwb-legal__header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--fwb-grey-200);
  }
  .fwb-legal__title { font-style: italic; font-weight: 300; margin-top: 0.6rem; }
  .fwb-legal__body { display: flex; flex-direction: column; gap: 3rem; }

  .fwb-legal__card {
    background: var(--fwb-white);
    border: 1px solid var(--fwb-grey-200);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 380px;
  }
  .fwb-legal__card-label { color: var(--fwb-grey-500); margin-bottom: 0.25rem; }
  .fwb-legal__address {
    font-style: normal;
    line-height: 1.9;
    font-size: 0.95rem;
    color: var(--fwb-grey-700);
  }
  .fwb-legal__email {
    font-size: 0.9rem;
    color: var(--fwb-black);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity var(--fwb-transition);
  }
  .fwb-legal__email:hover { opacity: 0.6; }

  .fwb-prose { color: var(--fwb-grey-700); line-height: 1.85; }
  .fwb-prose h2 {
    font-family: var(--fwb-font-heading);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 400;
    font-style: italic;
    color: var(--fwb-black);
    margin: 2.75rem 0 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--fwb-grey-200);
  }
  .fwb-prose h2:first-child { margin-top: 0; }
  .fwb-prose p { font-size: 0.91rem; margin: 0 0 1.2rem; }
  .fwb-prose p:last-child { margin-bottom: 0; }
  .fwb-prose ul, .fwb-prose ol { padding-left: 1.4rem; margin: 0 0 1.2rem; }
  .fwb-prose li { font-size: 0.91rem; margin-bottom: 0.35rem; }
  .fwb-prose strong { font-weight: 600; color: var(--fwb-black); }
  .fwb-prose a {
    color: var(--fwb-black);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity var(--fwb-transition);
  }
  .fwb-prose a:hover { opacity: 0.6; }
  .fwb-prose__address {
    font-style: normal;
    line-height: 2;
    font-size: 0.91rem;
    background: var(--fwb-white);
    border: 1px solid var(--fwb-grey-200);
    padding: 1.5rem 1.75rem;
    margin-bottom: 1.5rem;
    display: inline-block;
  }
  .fwb-prose__note {
    margin-top: 2rem !important;
    padding-top: 1.5rem;
    border-top: 1px solid var(--fwb-grey-200);
    font-size: 0.82rem !important;
    color: var(--fwb-grey-500) !important;
  }
{% endstylesheet %}

